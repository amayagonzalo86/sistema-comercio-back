# ─────────────────────────────────────────────────────────────
# Copiá este archivo a .env y completá TODOS los valores.
# Nunca subas .env a Git. En producción cargá estas variables
# desde el panel del proveedor (Render/Railway) o un gestor de secretos.
# ─────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
# Orígenes exactos del frontend, separados por coma (sin barra final, sin *).
# En producción deben ser HTTPS, por ejemplo: https://app.tuempresa.com.ar
ALLOWED_ORIGINS=http://localhost:5173

# Base de datos (en producción: usuario propio con permisos mínimos, nunca root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_app
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA
DB_NAME=sistema_comercio
DB_POOL_SIZE=10
# true si la base está en otro servidor (MySQL administrado): cifra la conexión con TLS
DB_SSL=false

# Secretos JWT: distintos entre sí, mínimo 32 caracteres aleatorios.
# Generalos con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=GENERAR_SECRETO_ACCESS
JWT_REFRESH_SECRET=GENERAR_SECRETO_REFRESH

# Proxies confiables delante de la API: 0 = directo, 1 = Nginx o Cloudflare, 2 = Cloudflare + Nginx.
# Necesario para que el rate limit y la lista blanca IP vean la IP real del cliente.
TRUST_PROXY_HOPS=0

# Límite global de peticiones por IP: THROTTLE_LIMIT peticiones cada THROTTLE_TTL segundos
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# Tamaño máximo del cuerpo JSON
BODY_LIMIT=200kb

# ── Factura electrónica ARCA ─────────────────────────────────
# Clave para cifrar el ticket de acceso de ARCA en la base (32+ caracteres; si falta se deriva de JWT_ACCESS_SECRET).
# FISCAL_ENCRYPTION_KEY=
# Opción 1: certificado y clave en variables (PEM o PEM en base64) y en el perfil fiscal "env:ARCA_CERT" / "env:ARCA_KEY".
# ARCA_CERT=
# ARCA_KEY=
# Opción 2: archivos en una carpeta del servidor y en el perfil fiscal "file:empresa.crt" / "file:empresa.key".
# FISCAL_SECRETS_DIR=/etc/erp/arca
# Solo si ARCA cambia sus direcciones (por defecto se usan las oficiales):
# ARCA_WSAA_URL_HOMO=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
# ARCA_WSFE_URL_HOMO=https://wswhomo.afip.gov.ar/wsfev1/service.asmx
# ARCA_WSAA_URL_PROD=https://wsaa.afip.gov.ar/ws/services/LoginCms
# ARCA_WSFE_URL_PROD=https://servicios1.afip.gov.ar/wsfev1/service.asmx
