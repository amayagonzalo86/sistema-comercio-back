# ─────────────────────────────────────────────────────────────
# Copiá este archivo a .env.local. Nunca subas .env.local a Git.
# Este frontend NO guarda secretos: todo lo que empieza con NEXT_PUBLIC_ es visible en el navegador.
# ─────────────────────────────────────────────────────────────

# Origen del backend NestJS (sin /api/v1 ni barra final). Next.js reenvía /api/v1/* a esta dirección,
# así el navegador habla con un solo origen y la cookie HttpOnly de sesión funciona sin CORS.
# Se lee al compilar (next build): si cambia, volvé a compilar.
API_ORIGIN=http://localhost:3000

# Nombre comercial que se muestra en la pantalla de ingreso y en la barra lateral.
NEXT_PUBLIC_APP_NAME=Comercio ERP
